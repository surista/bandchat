generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String?
  displayName         String
  avatarUrl           String?
  emailVerified       Boolean   @default(false)
  verificationToken   String?   @unique
  verificationExpires DateTime?
  googleId            String?   @unique
  authProvider        String    @default("local")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspaces              WorkspaceMember[]
  messages                Message[]
  channelMembers          ChannelMember[]
  pushSubscriptions       PushSubscription[]
  refreshTokens           RefreshToken[]
  reactions               Reaction[]
  songs                   Song[]
  setlists                Setlist[]
  gigs                    Gig[]
  availability            MemberAvailability[]
  medleys                 Medley[]
  contacts                Contact[]
  announcements           Announcement[]
  acknowledgments         AnnouncementAcknowledgment[]
  polls                   Poll[]
  pollVotes               PollVote[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id                  String    @id @default(uuid())
  name                String
  inviteCode          String    @unique
  inviteCodeExpiresAt DateTime?
  inviteMaxUses       Int?      // null = unlimited
  inviteUsedCount     Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members       WorkspaceMember[]
  channels      Channel[]
  channelGroups ChannelGroup[]
  songs         Song[]
  setlists      Setlist[]
  gigs          Gig[]
  bandMembers   BandMember[]
  availability  MemberAvailability[]
  medleys       Medley[]
  contacts      Contact[]
  announcements Announcement[]
  polls         Poll[]
}

model ChannelGroup {
  id          String   @id @default(uuid())
  name        String
  position    Int      @default(0)
  isCollapsed Boolean  @default(false)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  Channel[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  isDirect    Boolean  @default(false)
  workspaceId String
  groupId     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group     ChannelGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  messages  Message[]
  polls     Poll[]

  @@unique([workspaceId, name])
  @@index([groupId, position])
  @@index([workspaceId, isDirect])
}

model ChannelMember {
  userId    String
  channelId String
  muted     Boolean  @default(false)
  lastRead  DateTime @default(now())
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id              String   @id @default(uuid())
  content         String
  authorId        String
  channelId       String
  parentId        String?
  isHidden        Boolean  @default(false)
  removedUserName String?  // Set when user is removed with 'anonymize' option
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent      Message?     @relation("Threads", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("Threads")
  attachments Attachment[]
  reactions   Reaction[]

  @@index([channelId, createdAt])
  @@index([parentId])
}

model Attachment {
  id        String         @id @default(uuid())
  messageId String
  type      AttachmentType
  url       String
  filename  String
  size      Int?
  createdAt DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  MEMBER
}

enum AttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
  LINK
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

// Band Features

model Song {
  id          String   @id @default(uuid())
  title       String
  shortName   String?
  artist      String?
  duration    Int?
  key         String?
  bpm         Int?
  notes       String?
  lyrics      String?  // Lyrics or chord chart text
  arrangement String?  // Custom arrangement notes (intro, solo, ending, etc.)
  youtubeUrl  String?
  spotifyUrl  String?
  workspaceId String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User             @relation(fields: [createdById], references: [id])
  setlistSongs SetlistSong[]
  gigSongs     GigSong[]
  attachments  SongAttachment[]
  medleySongs  MedleySong[]

  @@unique([workspaceId, title, artist])
  @@index([workspaceId])
}

// Song file attachments (PDFs, chord sheets, etc.)
model SongAttachment {
  id        String   @id @default(uuid())
  songId    String
  filename  String
  url       String
  type      String   // 'pdf', 'doc', 'image', etc.
  size      Int?
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model Setlist {
  id            String    @id @default(uuid())
  name          String
  description   String?
  useShortNames Boolean   @default(false)
  performedAt   DateTime? // Date the setlist was performed
  venue         String?   // Venue name for the performance
  workspaceId   String
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id])
  songs       SetlistSong[]
  gigs        Gig[]               // Legacy single-setlist relation
  gigSetlists GigSetlist[]        // Multi-set support
  performers  SetlistPerformer[]  // Band members who performed this setlist

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, performedAt])
}

model SetlistSong {
  id        String          @id @default(uuid())
  setlistId String
  songId    String?
  position  Int
  type      SetlistItemType @default(SONG)
  duration  Int?            // For MC/break items (in seconds)
  label     String?         // Optional label for MC sections

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song    Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@index([setlistId, position])
}

enum SetlistItemType {
  SONG
  MC
  SET_BREAK
}

model Gig {
  id          String    @id @default(uuid())
  title       String
  type        GigType   @default(GIG)
  date        DateTime
  endDate     DateTime?
  venue       String?
  address     String?
  notes       String?
  pay         Float?
  status      GigStatus @default(SCHEDULED)
  isLocked    Boolean   @default(false) // Admin-only: non-admins cannot edit/delete
  isPersonal  Boolean   @default(false) // Personal entry: only visible to creator
  setlistId   String?   // Legacy single setlist - kept for backward compatibility
  workspaceId String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  setlist     Setlist?     @relation(fields: [setlistId], references: [id], onDelete: SetNull)
  setlists    GigSetlist[] // Multi-set support
  songsPlayed GigSong[]
  media       GigMedia[]

  @@index([workspaceId, date])
}

model GigSetlist {
  id        String   @id @default(uuid())
  gigId     String
  setlistId String
  setNumber Int      // 1, 2, 3, etc.
  createdAt DateTime @default(now())

  gig     Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  @@unique([gigId, setNumber])
  @@unique([gigId, setlistId])
  @@index([gigId])
}

model GigMedia {
  id        String   @id @default(uuid())
  gigId     String
  type      String   // 'image', 'video', 'youtube', 'link'
  url       String
  caption   String?
  createdAt DateTime @default(now())

  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId])
}

model GigSong {
  id     String @id @default(uuid())
  gigId  String
  songId String

  gig  Gig  @relation(fields: [gigId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([gigId, songId])
}

enum GigType {
  GIG
  REHEARSAL
  RECORDING
  OTHER
}

enum GigStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model BandMember {
  id          String    @id @default(uuid())
  name        String
  imageUrl    String?
  notes       String?
  isGuest     Boolean   @default(false)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stints       InstrumentStint[]
  performances SetlistPerformer[]

  @@index([workspaceId])
}

model InstrumentStint {
  id           String    @id @default(uuid())
  bandMemberId String
  instruments  String[]
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  bandMember BandMember @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)

  @@index([bandMemberId])
}

model SetlistPerformer {
  id           String @id @default(uuid())
  setlistId    String
  bandMemberId String

  setlist    Setlist    @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  bandMember BandMember @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)

  @@unique([setlistId, bandMemberId])
  @@index([setlistId])
}

// Member Availability Calendar
model MemberAvailability {
  id          String             @id @default(uuid())
  userId      String
  workspaceId String
  date        DateTime           @db.Date
  status      AvailabilityStatus
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, date])
  @@index([workspaceId, date])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

// Medley - group of songs that play back-to-back
model Medley {
  id          String   @id @default(uuid())
  name        String
  description String?
  workspaceId String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
  songs     MedleySong[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model MedleySong {
  id        String @id @default(uuid())
  medleyId  String
  songId    String
  position  Int

  medley Medley @relation(fields: [medleyId], references: [id], onDelete: Cascade)
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([medleyId, songId])
  @@index([medleyId, position])
}

// Shared Contacts (venues, sound engineers, photographers, etc.)
model Contact {
  id          String   @id @default(uuid())
  name        String
  category    String   // 'venue', 'sound_engineer', 'photographer', 'agent', 'other'
  email       String?
  phone       String?
  website     String?
  address     String?
  notes       String?
  workspaceId String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, category])
}

// Announcements - pinned messages with acknowledgment tracking
model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  priority    String   @default("normal") // 'low', 'normal', 'high', 'urgent'
  isPinned    Boolean  @default(true)
  workspaceId String
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                          @relation(fields: [createdById], references: [id])
  acknowledgments  AnnouncementAcknowledgment[]

  @@index([workspaceId])
  @@index([workspaceId, isPinned])
}

model AnnouncementAcknowledgment {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  acknowledgedAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
}

// Polls/Voting
model Poll {
  id          String    @id @default(uuid())
  question    String
  description String?
  allowMultiple Boolean @default(false)
  isAnonymous Boolean   @default(false)
  isClosed    Boolean   @default(false)
  workspaceId String
  channelId   String?   // Optional: poll can be in a channel
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy User         @relation(fields: [createdById], references: [id])
  options   PollOption[]

  @@index([workspaceId])
  @@index([channelId])
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  text     String
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(uuid())
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
}
