generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  password                String?
  displayName             String
  avatarUrl               String?
  bio                     String?
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationExpires     DateTime?
  pendingEmail            String?
  passwordResetToken      String?   @unique
  passwordResetExpires    DateTime?
  googleId                String?   @unique
  authProvider            String    @default("local")
  isSystemAdmin           Boolean   @default(false)
  notificationsSnoozedUntil DateTime? // null = active, future date = snoozed until then
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([isSystemAdmin])
  @@index([authProvider])
  @@index([deletedAt])

  workspaces              WorkspaceMember[]
  messages                Message[]
  channelMembers          ChannelMember[]
  pushSubscriptions       PushSubscription[]
  refreshTokens           RefreshToken[]
  reactions               Reaction[]
  songs                   Song[]
  setlists                Setlist[]
  gigs                    Gig[]
  availability            MemberAvailability[]
  medleys                 Medley[]
  contacts                Contact[]
  announcements           Announcement[]
  acknowledgments         AnnouncementAcknowledgment[]
  polls                   Poll[]
  pollVotes               PollVote[]
  timelineEvents          TimelineEvent[]
  memberAchievements      MemberAchievement[]
  recordings              Recording[]
  bandMemberLinks         BandMember[]
  kittyTransactions       KittyTransaction[]
  threadReads             ThreadRead[]
  pinnedMessages          PinnedMessage[]
  reportsMade             Report[]        @relation("reportsMade")
  blocksInitiated         BlockedUser[]   @relation("blocksInitiated")
  blocksReceived          BlockedUser[]   @relation("blocksReceived")
  practiceSessions        PracticeSession[]
  uploadedGigMedia        GigMedia[]
  savedMessages           SavedMessage[]
  expoPushTokens          ExpoPushToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id                  String    @id @default(uuid())
  name                String
  slug                String?   @unique
  inviteCode          String    @unique
  inviteCodeExpiresAt DateTime?
  inviteMaxUses       Int?      // null = unlimited
  inviteUsedCount     Int       @default(0)
  storageUsedBytes    BigInt    @default(0)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  calendarToken    String?   @unique
  currency         String    @default("USD")
  defaultEventType String    @default("GIG")
  defaultStartTime String    @default("19:00")
  defaultEndTime   String    @default("21:00")
  defaultVenue     String?

  // Subscription
  plan              String    @default("FREE")   // "FREE" or "PRO"
  planSource        String?                       // "APPLE", "GOOGLE", "STRIPE", "MANUAL"
  planProductId     String?                       // IAP product ID
  planExpiresAt     DateTime?                     // null = lifetime or free
  planOriginalTxId  String?   @unique             // prevents duplicate redemption
  planUpdatedAt     DateTime?

  members       WorkspaceMember[]
  channels      Channel[]
  channelGroups ChannelGroup[]
  songs         Song[]
  setlists      Setlist[]
  gigs          Gig[]
  bandMembers   BandMember[]
  availability  MemberAvailability[]
  medleys       Medley[]
  contacts      Contact[]
  announcements       Announcement[]
  polls               Poll[]
  timelineEvents      TimelineEvent[]
  memberAchievements  MemberAchievement[]
  bandAchievements    BandAchievement[]
  recordings          Recording[]
  bandKitty           BandKitty?
  practiceSessions    PracticeSession[]

  @@index([deletedAt])
}

model ChannelGroup {
  id          String   @id @default(uuid())
  name        String
  position    Int      @default(0)
  isCollapsed Boolean  @default(false)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  Channel[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  notifyDMs             Boolean @default(true)
  notifyMentions        Boolean @default(true)
  notifyGigChanges      Boolean @default(true)
  notifyAnnouncements   Boolean @default(true)
  notifyChannelMessages Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId, role])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  isDirect    Boolean  @default(false)
  workspaceId String
  groupId     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group     ChannelGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members        ChannelMember[]
  messages       Message[]
  polls          Poll[]
  pinnedMessages PinnedMessage[]

  @@unique([workspaceId, name])
  @@index([groupId, position])
  @@index([workspaceId, isDirect])
}

model ChannelMember {
  userId    String
  channelId String
  muted     Boolean  @default(false)
  lastRead  DateTime @default(now())
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id              String   @id @default(uuid())
  content         String
  authorId        String?
  channelId       String
  parentId        String?
  isHidden        Boolean  @default(false)
  removedUserName String?  // Set when user is removed/deleted (preserves display name)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent      Message?     @relation("Threads", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("Threads")
  attachments Attachment[]
  reactions       Reaction[]
  threadReads     ThreadRead[]
  pinnedMessages  PinnedMessage[]
  savedMessages   SavedMessage[]
  reports         Report[]

  @@index([channelId, createdAt])
  @@index([parentId])
  @@index([authorId, createdAt])
}

model Attachment {
  id           String         @id @default(uuid())
  messageId    String
  type         AttachmentType
  url          String
  filename     String
  size         Int?
  thumbnailUrl String?
  width        Int?
  height       Int?
  createdAt    DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum Role {
  ADMIN
  MEMBER
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LINK
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" or "android"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
  @@index([userId, createdAt])
}

model ThreadRead {
  userId    String
  messageId String
  lastRead  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

model PinnedMessage {
  id         String   @id @default(uuid())
  messageId  String
  channelId  String
  pinnedById String?
  createdAt  DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedBy   User?    @relation(fields: [pinnedById], references: [id], onDelete: SetNull)

  @@unique([messageId, channelId])
  @@index([channelId])
}

model SavedMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
}

// Band Features

model Song {
  id          String   @id @default(uuid())
  title       String
  shortName   String?
  artist      String?
  duration    Int?
  key         String?
  bpm         Int?
  notes       String?
  lyrics      String?  // Lyrics or chord chart text
  arrangement String?  // Custom arrangement notes (intro, solo, ending, etc.)
  youtubeUrl  String?
  spotifyUrl  String?
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  setlistSongs     SetlistSong[]
  gigSongs         GigSong[]
  attachments      SongAttachment[]
  medleySongs      MedleySong[]
  recordings       Recording[]
  practiceSessions PracticeSession[]

  @@unique([workspaceId, title, artist])
  @@index([workspaceId])
}

// Song file attachments (PDFs, chord sheets, etc.)
model SongAttachment {
  id        String   @id @default(uuid())
  songId    String
  filename  String
  url       String
  type      String   // 'pdf', 'doc', 'image', etc.
  size      Int?
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model Setlist {
  id            String    @id @default(uuid())
  name          String
  description   String?
  useShortNames Boolean   @default(false)
  performedAt   DateTime? // Date the setlist was performed
  venue         String?   // Venue name for the performance
  startTime     String?   // "HH:mm" format e.g. "19:30"
  isAutoCreated Boolean   @default(false) // True if auto-created with a gig
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  songs       SetlistSong[]
  gigs        Gig[]               // Legacy single-setlist relation
  gigSetlists GigSetlist[]        // Multi-set support
  performers  SetlistPerformer[]  // Band members who performed this setlist

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, performedAt])
}

model SetlistSong {
  id        String          @id @default(uuid())
  setlistId String
  songId    String?
  position  Int
  type      SetlistItemType @default(SONG)
  duration  Int?            // For MC/break items (in seconds)
  label     String?         // Optional label for MC sections

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song    Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@index([setlistId, position])
}

enum SetlistItemType {
  SONG
  MC
  SET_BREAK
}

model Gig {
  id          String    @id @default(uuid())
  title       String
  type        GigType   @default(GIG)
  date        DateTime
  endDate     DateTime?
  venue       String?
  address     String?
  notes       String?
  pay         Decimal?  @db.Decimal(10, 2) // Currency stored as decimal to avoid rounding errors
  status      GigStatus @default(SCHEDULED)
  isLocked    Boolean   @default(false) // Admin-only: non-admins cannot edit/delete
  isPersonal  Boolean   @default(false) // Personal entry: only visible to creator
  setlistId   String?   // Legacy single setlist - kept for backward compatibility
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  setlist           Setlist?           @relation(fields: [setlistId], references: [id], onDelete: SetNull)
  setlists          GigSetlist[]       // Multi-set support
  songsPlayed       GigSong[]
  media             GigMedia[]
  attendees         GigAttendee[]
  kittyTransactions KittyTransaction[]

  @@index([workspaceId, date])
}

model GigAttendee {
  id           String   @id @default(uuid())
  gigId        String
  bandMemberId String
  status       AttendeeStatus @default(ATTENDING)
  createdAt    DateTime @default(now())

  gig        Gig        @relation(fields: [gigId], references: [id], onDelete: Cascade)
  bandMember BandMember @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)

  @@unique([gigId, bandMemberId])
  @@index([gigId])
}

enum AttendeeStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

model GigSetlist {
  id        String   @id @default(uuid())
  gigId     String
  setlistId String
  setNumber Int      // 1, 2, 3, etc.
  createdAt DateTime @default(now())

  gig     Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  @@unique([gigId, setNumber])
  @@unique([gigId, setlistId])
  @@index([gigId])
}

model GigMedia {
  id           String   @id @default(uuid())
  gigId        String
  type         String   // 'image', 'video', 'youtube', 'link'
  url          String
  size         Int?     // File size in bytes
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  gig        Gig   @relation(fields: [gigId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([gigId])
  @@index([uploadedById])
}

model GigSong {
  id     String @id @default(uuid())
  gigId  String
  songId String

  gig  Gig  @relation(fields: [gigId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([gigId, songId])
}

enum GigType {
  GIG
  REHEARSAL
  RECORDING
  OTHER
}

enum GigStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model BandMember {
  id           String    @id @default(uuid())
  name         String
  imageUrl     String?
  notes        String?
  isGuest      Boolean   @default(false)
  linkedUserId String?   // Optional link to a workspace user account
  workspaceId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedUser     User?               @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  stints         InstrumentStint[]
  performances   SetlistPerformer[]
  gigAttendances GigAttendee[]

  @@index([workspaceId])
  @@index([linkedUserId])
}

model InstrumentStint {
  id           String    @id @default(uuid())
  bandMemberId String
  instruments  String[]
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  bandMember BandMember @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)

  @@index([bandMemberId])
}

model SetlistPerformer {
  id           String @id @default(uuid())
  setlistId    String
  bandMemberId String

  setlist    Setlist    @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  bandMember BandMember @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)

  @@unique([setlistId, bandMemberId])
  @@index([setlistId])
}

// Member Availability Calendar
model MemberAvailability {
  id          String             @id @default(uuid())
  userId      String
  workspaceId String
  date        DateTime           @db.Date
  status      AvailabilityStatus
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, date])
  @@index([workspaceId, date])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

// Medley - group of songs that play back-to-back
model Medley {
  id          String   @id @default(uuid())
  name        String
  description String?
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  songs     MedleySong[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model MedleySong {
  id        String @id @default(uuid())
  medleyId  String
  songId    String
  position  Int

  medley Medley @relation(fields: [medleyId], references: [id], onDelete: Cascade)
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([medleyId, songId])
  @@index([medleyId, position])
}

// Shared Contacts (venues, sound engineers, photographers, etc.)
model Contact {
  id          String   @id @default(uuid())
  name        String
  category    String   // 'venue', 'sound_engineer', 'photographer', 'agent', 'other'
  email       String?
  phone       String?
  website     String?
  address     String?
  notes       String?
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, category])
}

// Announcements - pinned messages with acknowledgment tracking
model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  priority    String   @default("normal") // 'low', 'normal', 'high', 'urgent'
  isPinned    Boolean  @default(true)
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User?                         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  acknowledgments  AnnouncementAcknowledgment[]

  @@index([workspaceId])
  @@index([workspaceId, isPinned])
  @@index([workspaceId, expiresAt])
}

model AnnouncementAcknowledgment {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  acknowledgedAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
}

// Polls/Voting
model Poll {
  id          String    @id @default(uuid())
  question    String
  description String?
  allowMultiple Boolean @default(false)
  isAnonymous Boolean   @default(false)
  isClosed    Boolean   @default(false)
  workspaceId String
  channelId          String?   // Optional: poll can be in a channel
  createdById        String?
  removedCreatorName String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  options   PollOption[]

  @@index([workspaceId])
  @@index([channelId])
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  text     String
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(uuid())
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
}

// Band Timeline - milestones and events in band history
model TimelineEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   String   // 'formation', 'first_gig', 'member_joined', 'member_left', 'album_release', 'milestone', 'custom'
  eventDate   DateTime
  imageUrl    String?
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, eventDate])
  @@index([createdById])
}

// Achievement definitions
model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique // 'first_gig', 'hundred_gigs', 'road_warrior', etc.
  name        String
  description String
  icon        String   // emoji or icon name
  category    String   // 'gigs', 'songs', 'rehearsals', 'social', 'milestones'
  threshold   Int?     // numeric threshold for auto-awards (e.g., 100 for "100 gigs")
  isBandWide  Boolean  @default(false) // true = band achievement, false = member achievement
  createdAt   DateTime @default(now())

  memberAchievements MemberAchievement[]
  bandAchievements   BandAchievement[]
}

// Achievements earned by workspace members
model MemberAchievement {
  id            String   @id @default(uuid())
  achievementId String
  userId        String
  workspaceId   String
  earnedAt      DateTime @default(now())
  metadata      Json?    // Extra data like "gigId" for context

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([achievementId, userId, workspaceId])
  @@index([userId, workspaceId])
}

// Achievements earned by the band (workspace)
model BandAchievement {
  id            String   @id @default(uuid())
  achievementId String
  workspaceId   String
  earnedAt      DateTime @default(now())
  metadata      Json?

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([achievementId, workspaceId])
  @@index([workspaceId])
}

// Quick audio/video recordings
model Recording {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String   // Cloudinary URL
  type        String   // 'audio', 'video'
  duration    Int?     // Duration in seconds
  size        Int?     // File size in bytes
  songId      String?  // Optional link to a song
  workspaceId        String
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  song      Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([songId])
  @@index([createdById])
}

// Band Kitty - Financial tracking for the band
model BandKitty {
  id              String   @id @default(uuid())
  workspaceId     String   @unique
  startingBalance Decimal  @default(0) @db.Decimal(10, 2) // Currency as decimal
  balanceAsOfDate DateTime @default(now())
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions KittyTransaction[]
}

model KittyTransaction {
  id          String               @id @default(uuid())
  kittyId     String
  type        KittyTransactionType
  category    String?              // For EXPENSE: 'equipment', 'travel', 'rehearsal', 'promo', 'other'
  amount      Decimal              @db.Decimal(10, 2) // Currency as decimal
  description String
  date        DateTime             @default(now())
  gigId       String?              // Link to gig if auto-created from gig completion
  createdById        String?
  removedCreatorName String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  kitty     BandKitty @relation(fields: [kittyId], references: [id], onDelete: Cascade)
  gig       Gig?      @relation(fields: [gigId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kittyId, date])
  @@index([gigId])
}

enum KittyTransactionType {
  GIG_PAY
  FEE
  EXPENSE
  OTHER_INCOME
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  messageId  String
  reason     String
  createdAt  DateTime @default(now())

  reporter User    @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId])
  @@index([messageId])
}

model BlockedUser {
  id            String   @id @default(uuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker     User @relation("blocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("blocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
}

model PracticeSession {
  id          String   @id @default(uuid())
  songId      String
  userId      String
  workspaceId String
  duration    Int      // minutes
  notes       String?
  practicedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  song      Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([userId, workspaceId])
  @@index([workspaceId, practicedAt])
}
