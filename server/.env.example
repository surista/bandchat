# ===========================================
# BandChat Server Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ------------------------------------------
# Database (Required)
# ------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/bandchat?schema=public"

# ------------------------------------------
# Authentication (Required)
# ------------------------------------------
# JWT secret keys - use long random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# ------------------------------------------
# Server Configuration (Required)
# ------------------------------------------
# Port for the Express server
PORT=3001

# Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL="http://localhost:5173"

# ------------------------------------------
# Google OAuth (Optional - enables Google Sign-In)
# ------------------------------------------
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ------------------------------------------
# Cloudinary (Legacy — existing URLs still served from Cloudinary)
# ------------------------------------------
# No longer used for new uploads (R2 handles those).
# Keep these if you have legacy Cloudinary URLs in the database.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# ------------------------------------------
# Cloudflare R2 Storage (Required for file uploads)
# ------------------------------------------
# Create a bucket at: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="bandchat"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ------------------------------------------
# Push Notifications (Optional - enables web push)
# ------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="admin@yourdomain.com"

# ------------------------------------------
# Email Service (Optional - enables email features)
# ------------------------------------------
# Using Resend (https://resend.com)
RESEND_API_KEY="re_your_api_key"
RESEND_DOMAIN="yourdomain.com"
EMAIL_FROM="BandChat <noreply@yourdomain.com>"

# ------------------------------------------
# YouTube API (Optional - enables video metadata)
# ------------------------------------------
# Get API key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="your-youtube-api-key"

# ------------------------------------------
# Environment
# ------------------------------------------
NODE_ENV="development"
