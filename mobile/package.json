{
  "name": "mobile",
  "version": "1.06.82",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src/ --quiet",
    "lint:critical": "eslint src/ --rule '{\"no-undef\": \"error\"}' --quiet",
    "test": "jest src/",
    "test:smoke": "jest __tests__/",
    "precommit": "npm run lint:critical",
    "postinstall": "npx patch-package",
    "bump:patch": "node ../client/scripts/bump-version.js patch",
    "bump:minor": "node ../client/scripts/bump-version.js minor",
    "bump:major": "node ../client/scripts/bump-version.js major",
    "build:ios": "eas build --platform ios --profile production --local --non-interactive",
    "build:android": "ANDROID_HOME=\"${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}\" ANDROID_SDK_ROOT=\"${ANDROID_SDK_ROOT:-/opt/homebrew/share/android-commandlinetools}\" eas build --platform android --profile production --local --non-interactive",
    "submit:ios": "eas submit --platform ios --profile production --path \"$(ls -t build-*.ipa 2>/dev/null | head -1)\" --non-interactive",
    "submit:android": "eas submit --platform android --profile production --path \"$(ls -t build-*.aab 2>/dev/null | head -1)\" --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.10",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-media-library": "~18.2.1",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-quick-actions": "^6.0.1",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-purchases": "^9.11.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-widget-extension": "^0.2.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.72.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.11",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|react-native-purchases|date-fns|socket\\.io-client|engine\\.io-client)"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js",
      "**/src/**/*.test.js"
    ],
    "globals": {
      "__DEV__": true
    }
  }
}
